{
  "name": "@sonic-ws/redis-adapter",
  "version": "0.1.0",
  "description": "Redis scaling adapter for SonicWS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
